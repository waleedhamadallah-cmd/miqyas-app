<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <receiver
            android:name=".CalorieWaterWidgetProvider"
            android:exported="true"
            android:label="مِقياس — السعرات والماء">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/calorie_water_widget_info" />
        </receiver>

        <receiver
            android:name=".StepsWidgetProvider"
            android:exported="true"
            android:label="مِقياس — الخطوات">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/steps_widget_info" />
        </receiver>

        <!-- Health Connect: shown when the user taps "privacy policy" on the
             system permission dialog. Required for Android 13 and below. -->
        <activity
            android:name=".PermissionsRationaleActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Health Connect: same rationale screen, routed differently on
             Android 14+ via this required alias. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".PermissionsRationaleActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Barcode scanning (docs/js/barcode.js's startBarcodeCamera(), the
         browser BarcodeDetector API over a getUserMedia() video stream) —
         without this declared here, Capacitor's bridge has nothing to grant
         at runtime, so getUserMedia() just fails silently in the WebView
         and the app falls back to manual barcode entry every time,
         regardless of what the user taps on Android's own permission
         dialog (there never was one). android:required="false" on the
         matching uses-feature below so a device/emulator with no camera at
         all can still install the app — barcode scanning already has that
         manual-entry fallback for exactly this case. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.health.WRITE_NUTRITION" />
    <uses-permission android:name="android.permission.health.WRITE_HYDRATION" />
    <!-- Body weight, written from the app's own weight-log entries — see
         syncHealthConnectWeight() in docs/js/core.js and writeWeight()/
         deleteWeight() in HealthConnectPlugin.kt. Without this manifest
         declaration, Health Connect never offers it as a grantable
         permission at all (it just silently doesn't appear in the app's
         "App access" screen), even though the Kotlin code already requests
         it in healthPermissions. -->
    <uses-permission android:name="android.permission.health.WRITE_WEIGHT" />
    <!-- Steps only, read-only, last 7 days, foreground/on-demand — see
         HealthConnectPlugin.kt's class doc. No history/background-read
         permission needed for that narrow a scope. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />

    <!-- Reminders: runtime permission required on Android 13+ before any
         local notification (meal/water reminders) can be shown. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Lets the app check whether Health Connect is installed. -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <!-- Not required to install — barcode scanning already falls back to
         manual entry when no camera is available. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
</manifest>
