<?xml version="1.0" encoding="utf-8"?>
<!-- "Over calorie goal" version of widget_stat_pill_bg.xml — same red
     gradient as the app's own #ringGradOver (see docs/index.html), swapped
     in via setInt(...,"setBackgroundResource",...) in StepsWidgetProvider
     when today's logged calories exceed the daily goal. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="0"
        android:startColor="#FF7A80"
        android:endColor="#E5555B"/>
    <corners android:radius="16dp"/>
</shape>
