<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded teal capsule behind each stat row (distance / calories) in the
     steps widget, echoing the reference design's two-tone accent pills. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="0"
        android:startColor="#2FD3A6"
        android:endColor="#1F9E82"/>
    <corners android:radius="16dp"/>
</shape>
