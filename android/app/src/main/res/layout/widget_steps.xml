<?xml version="1.0" encoding="utf-8"?>
<!-- Steps widget, redesigned to match the reference screenshot the user
     shared (header sync-time + refresh grouped on one side, a static
     "خطوات اليوم" badge on the other; a plain divided stat list instead of
     colored pill rows; a translucent bordered footer pill instead of a
     solid gradient one). Validated first as an HTML/CSS mockup
     (widget_mockup2.html) before being ported here 1:1.

     Data comes from SharedPreferences written by MiqyasWidgetPlugin (same
     mechanism as CalorieWaterWidgetProvider — see that class's doc
     comment), which the web app calls whenever it re-syncs steps from
     Health Connect. The ring itself is drawn as a Bitmap in
     StepsWidgetProvider (RemoteViews has no native arc/ring view), then
     layered under the text via the FrameLayout below.

     Uses layoutDirection="locale" + start/end gravity throughout (matching
     the existing widget_calorie_water.xml convention) so the whole thing
     mirrors correctly for the app's Arabic/RTL locale instead of needing a
     separate RTL layout. Element order below follows the validated mockup's
     source order (first child = right side in RTL, matching the reference
     image): header badge before the sync/refresh group, stats column
     before the ring, pill value before its label. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetStepsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="locale"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <!-- Header: static "today's steps" badge + sync time/refresh group -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="خطوات اليوم"
            android:background="@drawable/widget_badge_bg"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textColor="#5EE6C9"
            android:textSize="11sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical|end">

            <TextView
                android:id="@+id/widgetStepsSyncText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:text="--:--"
                android:textColor="#7C858F"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"/>

            <ImageView
                android:id="@+id/widgetStepsRefresh"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:padding="4dp"
                android:src="@drawable/ic_widget_refresh"
                android:contentDescription="تحديث"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Body: distance/calories stat list (start/right) + steps ring (end/left) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:padding="6dp"
                        android:background="@drawable/widget_icon_badge_bg"
                        android:src="@drawable/ic_widget_pin"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="المسافة"
                        android:textColor="#B7C0C7"
                        android:textSize="12sp"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/widgetStepsDistance"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="0.00 كم"
                    android:textColor="#F3F1EA"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@drawable/widget_divider_bg"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:padding="6dp"
                        android:background="@drawable/widget_icon_badge_bg_flame"
                        android:src="@drawable/ic_widget_flame"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="سعرات محروقة"
                        android:textColor="#B7C0C7"
                        android:textSize="12sp"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/widgetStepsCalories"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="0"
                    android:textColor="#F3F1EA"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

            </LinearLayout>

        </LinearLayout>

        <FrameLayout
            android:layout_width="100dp"
            android:layout_height="100dp">

            <ImageView
                android:id="@+id/widgetStepsRingImg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/widgetStepsValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#F3F1EA"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/widgetStepsGoalText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="من 8,000"
                    android:textColor="#7C858F"
                    android:textSize="10sp"/>

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

    <!-- Footer: today's remaining/over food calories (from the app's own
         dietary tracking — dateKey/calCurrent/calGoal, the same fields the
         calorie/water widget already uses), as a translucent bordered pill
         (teal when still under goal, maroon when over — see
         widget_pill_ok_translucent.xml / widget_pill_warn_translucent.xml)
         instead of the old solid-gradient pill. Value stays start/right,
         label end/left, matching the reference image's over-goal state. -->
    <LinearLayout
        android:id="@+id/widgetStepsCalEatenPill"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_pill_ok_translucent"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/widgetStepsCalEatenValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#5EE6C9"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/widgetStepsCalEatenLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="متبقية"
            android:textColor="#8FD9C6"
            android:textSize="12sp"/>

    </LinearLayout>

</LinearLayout>
