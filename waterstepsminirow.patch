+  <div class="sheet-handle"></div>
+  <div class="sheet-head"><h3><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.5c4 5 7 8.7 7 12.5a7 7 0 0 1-14 0c0-3.8 3-7.5 7-12.5z"></path></svg>الماء</h3><div class="sheet-close" data-close aria-label="إغلاق" role="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="6" y1="6" x2="18" y2="18"></line><line x1="18" y1="6" x2="6" y2="18"></line></svg></div></div>
+  <div class="sheet-body">
+    <div class="water-card">
+      <div class="water-head">
+        <div class="wh-title"><svg class="title-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.5c4 5 7 8.7 7 12.5a7 7 0 0 1-14 0c0-3.8 3-7.5 7-12.5z"></path></svg>اليوم</div>
+        <div class="wh-val tabular" id="waterValText">0 / 2500 مل</div>
+      </div>
