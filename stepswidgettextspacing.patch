From 0f45d0911150ddd7ef67f0d3d1918b7be7adeb42 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 18 Aug 2026 08:17:54 +0000
Subject: [PATCH] Fix jumbled/overlapping stat and footer text in steps widget
 by matching the header's proven weight+gravity wrapper pattern

---
 .../app/src/main/res/layout/widget_steps.xml  | 61 +++++++++++++------
 1 file changed, 41 insertions(+), 20 deletions(-)

diff --git a/android/app/src/main/res/layout/widget_steps.xml b/android/app/src/main/res/layout/widget_steps.xml
index 99078e9..e43e81e 100644
--- a/android/app/src/main/res/layout/widget_steps.xml
+++ b/android/app/src/main/res/layout/widget_steps.xml
@@ -125,16 +125,23 @@
 
                 </LinearLayout>
 
-                <TextView
-                    android:id="@+id/widgetStepsDistance"
+                <LinearLayout
                     android:layout_width="0dp"
                     android:layout_height="wrap_content"
                     android:layout_weight="1"
-                    android:gravity="end"
-                    android:text="0.00 كم"
-                    android:textColor="#F3F1EA"
-                    android:textSize="16sp"
-                    android:textStyle="bold"/>
+                    android:orientation="horizontal"
+                    android:gravity="center_vertical|end">
+
+                    <TextView
+                        android:id="@+id/widgetStepsDistance"
+                        android:layout_width="wrap_content"
+                        android:layout_height="wrap_content"
+                        android:text="0.00 كم"
+                        android:textColor="#F3F1EA"
+                        android:textSize="16sp"
+                        android:textStyle="bold"/>
+
+                </LinearLayout>
 
             </LinearLayout>
 
@@ -174,16 +181,23 @@
 
                 </LinearLayout>
 
-                <TextView
-                    android:id="@+id/widgetStepsCalories"
+                <LinearLayout
                     android:layout_width="0dp"
                     android:layout_height="wrap_content"
                     android:layout_weight="1"
-                    android:gravity="end"
-                    android:text="0"
-                    android:textColor="#F3F1EA"
-                    android:textSize="16sp"
-                    android:textStyle="bold"/>
+                    android:orientation="horizontal"
+                    android:gravity="center_vertical|end">
+
+                    <TextView
+                        android:id="@+id/widgetStepsCalories"
+                        android:layout_width="wrap_content"
+                        android:layout_height="wrap_content"
+                        android:text="0"
+                        android:textColor="#F3F1EA"
+                        android:textSize="16sp"
+                        android:textStyle="bold"/>
+
+                </LinearLayout>
 
             </LinearLayout>
 
@@ -257,15 +271,22 @@
             android:textSize="15sp"
             android:textStyle="bold"/>
 
-        <TextView
-            android:id="@+id/widgetStepsCalEatenLabel"
+        <LinearLayout
             android:layout_width="0dp"
             android:layout_height="wrap_content"
             android:layout_weight="1"
-            android:gravity="end"
-            android:text="متبقية"
-            android:textColor="#8FD9C6"
-            android:textSize="12sp"/>
+            android:orientation="horizontal"
+            android:gravity="center_vertical|end">
+
+            <TextView
+                android:id="@+id/widgetStepsCalEatenLabel"
+                android:layout_width="wrap_content"
+                android:layout_height="wrap_content"
+                android:text="متبقية"
+                android:textColor="#8FD9C6"
+                android:textSize="12sp"/>
+
+        </LinearLayout>
 
     </LinearLayout>
 
-- 
2.43.0

