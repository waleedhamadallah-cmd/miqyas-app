From fe5ed2574fa4c228cce844abcb620010a7c9694b Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 18 Aug 2026 05:43:18 +0000
Subject: [PATCH] Keep macro pills the same height regardless of over-goal
 state, center their text

---
 docs/css/styles.css | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/docs/css/styles.css b/docs/css/styles.css
index 24d0fc0..615985f 100644
--- a/docs/css/styles.css
+++ b/docs/css/styles.css
@@ -199,9 +199,14 @@ input{font-family:inherit; color:inherit;}
 
 .macro-row{display:flex; gap:10px; margin-top:14px;}
 .macro-pill{ flex:1; background:var(--bg-elev); border:1px solid var(--border-soft); border-radius:var(--r-md); padding:9px 11px 8px; transition:background .2s ease, border-color .2s ease; }
-.macro-pill .top{display:flex; justify-content:space-between; align-items:baseline; margin-bottom:8px;}
+/* Name on its own line, numbers on the line under it — for all three
+   pills equally, so the "over goal" state (longer digits + the ⚠ appended
+   below) can never make one pill taller than its siblings. Previously
+   name+value sat side by side and wrapped onto a 3rd line once the ⚠ no
+   longer fit next to a 3-digit/3-digit value, growing just that pill. */
+.macro-pill .top{display:flex; flex-direction:column; align-items:center; gap:3px; margin-bottom:8px; text-align:center;}
 .macro-pill .name{font-size:12px; color:var(--text-dim); font-weight:600;}
-.macro-pill .val{font-size:12px; font-weight:700; font-family:var(--font-d); transition:color .2s ease;}
+.macro-pill .val{font-size:12px; font-weight:700; font-family:var(--font-d); transition:color .2s ease; white-space:nowrap;}
 .macro-track{height:6px; border-radius:var(--r-pill); background:var(--border-soft); overflow:hidden;}
 .macro-fill{height:100%; border-radius:var(--r-pill); transition:width .6s cubic-bezier(.2,.8,.2,1), background .2s ease;}
 .macro-pill.protein .val{color:var(--protein-text);}
-- 
