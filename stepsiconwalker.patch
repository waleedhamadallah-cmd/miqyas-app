From 0f1d872402c0aaee7b06e20fcafe534e4c75aaa5 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 18 Aug 2026 02:45:45 +0000
Subject: [PATCH] Replace mismatched lightning-bolt steps icon with a
 walking-figure icon
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The steps feature (home card, connect prompt, weekly section title, and
the detail sheet header) used a lightning-bolt/flash glyph for 'خطوات'
(steps) -- visually unrelated to walking. Swapped in a small walking-
figure pictogram, tested at all the real render sizes used in the app
(12-22px) so it stays legible even at the smallest title-icon size.
---
 docs/index.html | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/docs/index.html b/docs/index.html
index 6683e51..dc78b3a 100644
--- a/docs/index.html
+++ b/docs/index.html
@@ -122,7 +122,7 @@
       <div class="activity-row steps-row" id="stepsCard" style="display:none;">
         <div id="stepsCardConnect" style="display:none;">
           <div class="steps-connect-row" id="stepsConnectPrompt">
-            <span class="steps-connect-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 3 4 14h7l-1 7 9-11h-7l1-7z"></path></svg></span>
+            <span class="steps-connect-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="13" cy="5" r="2"></circle><path d="M13 8v3l-3.5 2.5"></path><path d="M9 12l-3 7"></path><path d="M9 12l4 2 3 6"></path><path d="M13 11l3.5-1.5"></path></svg></span>
             <span class="steps-connect-tx">اربط Health Connect عشان نعرض خطواتك هنا (من تطبيق ساعتك، مثل Zepp)</span>
           </div>
         </div>
@@ -134,7 +134,7 @@
             </svg>
           </div>
           <div class="steps-mini-info">
-            <div class="steps-mini-title"><svg class="title-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 3 4 14h7l-1 7 9-11h-7l1-7z"></path></svg>خطوات</div>
+            <div class="steps-mini-title"><svg class="title-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="13" cy="5" r="2"></circle><path d="M13 8v3l-3.5 2.5"></path><path d="M9 12l-3 7"></path><path d="M9 12l4 2 3 6"></path><path d="M13 11l3.5-1.5"></path></svg>خطوات</div>
             <div class="steps-mini-val tabular"><span id="stepsValText">0</span> / <span id="stepsGoalText">8,000</span></div>
           </div>
           <div class="steps-mini-caption" id="stepsCaption">—</div>
@@ -194,7 +194,7 @@
          native app (see renderStepsTrendCard() in progress.js), since
          there's no step data source on the plain web/PWA. -->
     <div id="stepsTrendSection" style="display:none;">
-      <div class="section-title"><span class="st-title"><svg class="title-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 3 4 14h7l-1 7 9-11h-7l1-7z"></path></svg>خطوات الأسبوع</span></div>
+      <div class="section-title"><span class="st-title"><svg class="title-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="13" cy="5" r="2"></circle><path d="M13 8v3l-3.5 2.5"></path><path d="M9 12l-3 7"></path><path d="M9 12l4 2 3 6"></path><path d="M13 11l3.5-1.5"></path></svg>خطوات الأسبوع</span></div>
       <div class="insight-card" id="stepsTrendCard"></div>
     </div>
 
@@ -640,7 +640,7 @@
      access granted (nothing opens this sheet otherwise). -->
 <div class="sheet" id="sheetStepsDetail" style="max-height:92vh;">
   <div class="sheet-handle"></div>
-  <div class="sheet-head"><h3><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 3 4 14h7l-1 7 9-11h-7l1-7z"></path></svg>الخطوات</h3><div class="sheet-close" data-close aria-label="إغلاق" role="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="6" y1="6" x2="18" y2="18"></line><line x1="18" y1="6" x2="6" y2="18"></line></svg></div></div>
+  <div class="sheet-head"><h3><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="13" cy="5" r="2"></circle><path d="M13 8v3l-3.5 2.5"></path><path d="M9 12l-3 7"></path><path d="M9 12l4 2 3 6"></path><path d="M13 11l3.5-1.5"></path></svg>الخطوات</h3><div class="sheet-close" data-close aria-label="إغلاق" role="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="6" y1="6" x2="18" y2="18"></line><line x1="18" y1="6" x2="6" y2="18"></line></svg></div></div>
   <div class="sheet-body">
     <div class="steps-detail-hero">
       <div class="steps-ring-wrap lg">
-- 
