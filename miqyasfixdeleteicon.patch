From b9c06dbd58a27831c367d19e06d816b6073ee261 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 18 Aug 2026 01:35:24 +0000
Subject: [PATCH] Fix oversized/malformed delete-X icon on meal entries and
 templates
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

.entry-del and .tdel both use ICON_X (a viewBox-only SVG with no
width/height of its own) but, unlike every other icon button in this
file, never got their own svg size rule — so the icon stretched to fill
almost the entire circle instead of sitting as a normal small glyph
inside it. Sized to 16px, matching .sheet-close svg (the other 40px
var(--tap-min) circle that uses this same icon).
---
 docs/css/styles.css | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/docs/css/styles.css b/docs/css/styles.css
index 9f49083..fb757a0 100644
--- a/docs/css/styles.css
+++ b/docs/css/styles.css
@@ -311,6 +311,14 @@ input{font-family:inherit; color:inherit;}
   width:var(--tap-min); height:var(--tap-min); border-radius:50%; background:var(--bg-elev); border:1px solid var(--border);
   display:flex; align-items:center; justify-content:center; color:var(--text-mute); cursor:pointer; flex:0 0 auto;
 }
+/* ICON_X has no width/height of its own (just a viewBox), and unlike every
+   other icon button in this file (.sheet-close svg, .icon-btn svg, etc.)
+   this one never got its own size rule — so the browser stretched it to
+   fill almost the entire 40px circle edge-to-edge instead of sitting as a
+   normal small glyph inside it, which is what made it look oversized and
+   blobby. 16px matches .sheet-close svg, the other var(--tap-min) circle
+   that uses this exact same icon. */
+.entry-del svg, .tdel svg{width:16px; height:16px;}
 
 /* ============ DAYS STRIP (home — jump to another day) ============ */
 .date-strip{ display:flex; gap:7px; overflow-x:auto; padding:2px 2px 6px; margin-bottom:6px; scrollbar-width:none; }
