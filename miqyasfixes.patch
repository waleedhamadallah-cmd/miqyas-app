diff --git a/android/capacitor.settings.gradle b/android/capacitor.settings.gradle
index 9a5fa87..6bf445f 100644
--- a/android/capacitor.settings.gradle
+++ b/android/capacitor.settings.gradle
@@ -1,3 +1,9 @@
 // DO NOT EDIT THIS FILE! IT IS GENERATED EACH TIME "capacitor update" IS RUN
 include ':capacitor-android'
 project(':capacitor-android').projectDir = new File('../node_modules/@capacitor/android/capacitor')
+
+include ':capacitor-app'
+project(':capacitor-app').projectDir = new File('../node_modules/@capacitor/app/android')
+
+include ':capacitor-local-notifications'
+project(':capacitor-local-notifications').projectDir = new File('../node_modules/@capacitor/local-notifications/android')
diff --git a/docs/css/styles.css b/docs/css/styles.css
index 286999f..c2b6aae 100644
--- a/docs/css/styles.css
+++ b/docs/css/styles.css
@@ -96,6 +96,12 @@ button{font-family:inherit; color:inherit;}
 input{font-family:inherit; color:inherit;}
 ::selection{background:var(--accent); color:#12161A;}
 .tabular{ font-variant-numeric: tabular-nums; }
+/* Isolates a "number / number"-style numeric expression from the RTL bidi
+   algorithm so it can't get silently reordered when it's followed by an
+   Arabic word (see renderWaterCard() in home.js for the concrete bug this
+   fixes). Reusable anywhere else the same "X / Y <arabic unit>" shape shows
+   up. */
+.ltr-num{ direction:ltr; unicode-bidi:isolate; display:inline-block; }
 
 /* ============ SHELL ============ */
 #app{ max-width:480px; margin:0 auto; min-height:100vh; position:relative; padding-bottom:120px; }
@@ -484,7 +490,11 @@ input{font-family:inherit; color:inherit;}
 .lib-row .lm .d{font-size:12px; color:var(--text-mute); margin-top:3px;}
 .lib-row .star{color:var(--fat-text); font-size:12px;}
 .lib-add{
-  width:32px; height:32px; border-radius:50%; background:var(--surface-2); border:1px solid var(--border);
+  /* This is the single most-tapped control in the app (quick-add food to
+     today), yet it used to be smaller (32px) than the far-less-used
+     edit/delete icons right next to it (var(--tap-min), 40px) — exactly
+     backwards for tap-target sizing. Matched to --tap-min like its siblings. */
+  width:var(--tap-min); height:var(--tap-min); border-radius:50%; background:var(--surface-2); border:1px solid var(--border);
   color:var(--accent-text); font-size:17px; font-weight:800; display:flex; align-items:center; justify-content:center; flex:0 0 auto;
 }
 .lib-actions{display:flex; align-items:center; gap:8px; flex:0 0 auto;}
@@ -683,7 +693,16 @@ input{font-family:inherit; color:inherit;}
   box-shadow:var(--shadow-1); opacity:0; pointer-events:none; transition:all .25s cubic-bezier(.2,.8,.2,1);
   z-index:60; display:flex; align-items:center; gap:8px; max-width:88%;
 }
-#toast.show{opacity:1; transform:translate(-50%,0);}
+/* #toast itself is pointer-events:none so it never blocks taps on the UI
+   behind it while it's just informing (e.g. "أضيفت...") — but once it also
+   contains an actionable "تراجع" link (showUndoToast() in core.js), that
+   link has to explicitly opt back into being clickable, the same way
+   #overlay.show already does below. Without this, a real tap/click at the
+   button's on-screen position falls straight through to whatever is
+   underneath (confirmed via elementFromPoint()), so "تراجع" always looked
+   clickable but never actually was — every delete-with-undo (meal, custom
+   food, template) was silent, permanent data loss with no way to recover. */
+#toast.show{opacity:1; transform:translate(-50%,0); pointer-events:auto;}
 #toast .tick{color:var(--success); font-size:15px; display:flex; flex:0 0 auto;}
 #toast .tick svg{width:15px; height:15px;}
 
diff --git a/docs/js/app.js b/docs/js/app.js
index a87dbd8..3b484bd 100644
--- a/docs/js/app.js
+++ b/docs/js/app.js
@@ -184,6 +184,11 @@ function bindEvents(){
     renderWeightCard();
