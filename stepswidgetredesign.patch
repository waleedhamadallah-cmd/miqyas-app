new file mode 100644
index 0000000..4f903e6
--- /dev/null
+++ b/android/app/src/main/res/drawable/widget_badge_bg.xml
@@ -0,0 +1,8 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Teal "خطوات اليوم" pill badge in the steps widget header, matching the
+     reference design the user shared (see widget_mockup2.html this was
+     validated against before porting to native XML). -->
+<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
+    <solid android:color="#0E3B31"/>
+    <corners android:radius="20dp"/>
+</shape>
diff --git a/android/app/src/main/res/drawable/widget_divider_bg.xml b/android/app/src/main/res/drawable/widget_divider_bg.xml
