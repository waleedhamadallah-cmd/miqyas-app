+++ b/android/app/src/main/res/drawable/widget_pill_ok_translucent.xml
@@ -0,0 +1,10 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- "Under calorie goal" (still remaining) footer pill for the steps widget
+     — the reference image only showed the over-goal state, so this teal
+     translucent counterpart was designed to match its same treatment
+     (translucent fill + soft border, no icon) for visual consistency. -->
+<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
+    <solid android:color="#1F5EE6C9"/>
+    <stroke android:width="1dp" android:color="#595EE6C9"/>
+    <corners android:radius="14dp"/>
+</shape>
diff --git a/android/app/src/main/res/drawable/widget_pill_warn_translucent.xml b/android/app/src/main/res/drawable/widget_pill_warn_translucent.xml
new file mode 100644
index 0000000..c5e33f9
--- /dev/null
+++ b/android/app/src/main/res/drawable/widget_pill_warn_translucent.xml
@@ -0,0 +1,11 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- "Over calorie goal" footer pill for the steps widget, redesigned per the
+     reference image as a translucent dark-maroon bordered box (was a solid
+     red gradient before — see widget_stat_pill_bg_warn.xml, now unused by
+     the steps widget but left in place in case anything else references
+     it). -->
+<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
+    <solid android:color="#1FE5555B"/>
+    <stroke android:width="1dp" android:color="#59E5555B"/>
+    <corners android:radius="14dp"/>
+</shape>
