From 5956d336f589ce11e7050383a2cc0002a296e446 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 18 Aug 2026 02:51:23 +0000
Subject: [PATCH] Fix undersized edit-hint icon and duplicated sync label in
 steps sheet
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- .entry-edit-hint (the pencil hint on meal rows) was 14px at .45 opacity,
  which next to the bold 40px .entry-del circle read as a broken/tiny
  button rather than a deliberately subtle hint -- sized up to 18px with
  more contrast.
- The steps detail sheet's 'last sync' stat repeated its own label
  ('آخر مزامنة' shown once as the static .sd-label, then
  again inside the value text from stepsFreshnessCaption()) -- now
  strips the redundant prefix so it only shows once.
---
 docs/css/styles.css | 7 +++++--
 docs/js/home.js     | 7 ++++++-
 2 files changed, 11 insertions(+), 3 deletions(-)

diff --git a/docs/css/styles.css b/docs/css/styles.css
index c4a73c2..fb9fd33 100644
--- a/docs/css/styles.css
+++ b/docs/css/styles.css
@@ -308,8 +308,11 @@ input{font-family:inherit; color:inherit;}
 .entry-side{font-family:var(--font-d); font-weight:800; font-size:14px; color:var(--text-dim);}
 /* Passive hint that the whole row is tappable to edit the logged quantity —
    not its own tap target (the row click handler already covers it), just a
-   visual cue so the interaction isn't invisible/undiscoverable. */
-.entry-edit-hint{width:14px; height:14px; color:var(--text-mute); opacity:.45; flex:0 0 auto;}
+   visual cue so the interaction isn't invisible/undiscoverable. Was 14px at
+   .45 opacity, which next to the bold 40px .entry-del circle read as
+   broken/undersized rather than deliberately subtle — sized up a bit and
+   given more contrast so it reads as an intentional (if secondary) icon. */
+.entry-edit-hint{width:18px; height:18px; color:var(--text-dim); opacity:.65; flex:0 0 auto;}
 .entry-edit-hint svg{width:100%; height:100%;}
 .entry-del{
   width:var(--tap-min); height:var(--tap-min); border-radius:50%; background:var(--bg-elev); border:1px solid var(--border);
diff --git a/docs/js/home.js b/docs/js/home.js
index abb434f..13bc519 100644
--- a/docs/js/home.js
+++ b/docs/js/home.js
@@ -348,8 +348,13 @@ function renderStepsDetail(){
 
   document.getElementById('stepsDetailDist').textContent = `${estimateStepsDistanceKm(todaySteps).toFixed(2)} كم`;
   document.getElementById('stepsDetailCal').textContent = Math.round(estimateStepsCalories(todaySteps)).toLocaleString('en-US');
+  // stepsFreshnessCaption() returns a full sentence ("آخر مزامنة: قبل 5
+  // دقائق") meant to stand alone as the Home card's caption line. Here it's
+  // shown under a ".sd-label" that already reads "آخر مزامنة", so the raw
+  // text would repeat the label twice — strip the redundant prefix, keeping
+  // just the value ("قبل 5 دقائق" / "الآن" / "لم تتم المزامنة اليوم بعد").
   const fresh = stepsFreshnessCaption(todayEntry ? todayEntry.fetchedAt : null);
-  document.getElementById('stepsDetailSync').textContent = fresh.text;
+  document.getElementById('stepsDetailSync').textContent = fresh.text.replace(/^آخر مزامنة:\s*/, '');
 
   const {bars} = stepsDetailPeriod===30 ? stepsMonthlyBars() : stepsBarsForRange(7);
   const chartWrap = document.getElementById('stepsDetailChart');
-- 
2.43.0

