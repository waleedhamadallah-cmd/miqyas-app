From 1fc40040d538e2171d2fc749665232a014c4e598 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 18 Aug 2026 10:24:23 +0000
Subject: [PATCH] Declare CAMERA permission (+ optional camera uses-feature) so
 barcode scanning's getUserMedia() can actually open the camera

---
 android/app/src/main/AndroidManifest.xml | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/android/app/src/main/AndroidManifest.xml b/android/app/src/main/AndroidManifest.xml
index cec2c8d..775d7e2 100644
--- a/android/app/src/main/AndroidManifest.xml
+++ b/android/app/src/main/AndroidManifest.xml
@@ -85,6 +85,17 @@
     <!-- Permissions -->
 
     <uses-permission android:name="android.permission.INTERNET" />
+    <!-- Barcode scanning (docs/js/barcode.js's startBarcodeCamera(), the
+         browser BarcodeDetector API over a getUserMedia() video stream) —
+         without this declared here, Capacitor's bridge has nothing to grant
+         at runtime, so getUserMedia() just fails silently in the WebView
+         and the app falls back to manual barcode entry every time,
+         regardless of what the user taps on Android's own permission
+         dialog (there never was one). android:required="false" on the
+         matching uses-feature below so a device/emulator with no camera at
+         all can still install the app — barcode scanning already has that
+         manual-entry fallback for exactly this case. -->
+    <uses-permission android:name="android.permission.CAMERA" />
     <uses-permission android:name="android.permission.health.WRITE_NUTRITION" />
     <uses-permission android:name="android.permission.health.WRITE_HYDRATION" />
     <!-- Body weight, written from the app's own weight-log entries — see
@@ -108,4 +119,9 @@
     <queries>
         <package android:name="com.google.android.apps.healthdata" />
     </queries>
+
+    <!-- Not required to install — barcode scanning already falls back to
+         manual entry when no camera is available. -->
+    <uses-feature android:name="android.hardware.camera" android:required="false" />
+    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
 </manifest>
-- 
